{
	"name": "nuxt-avdeb",
	"version": "0.1.0",
	"description": "Nuxt module for AVDEB products: grid, carousel, list and spotlight components with your affiliate referral code on every link",
	"type": "module",
	"license": "MIT",
	"homepage": "https://avdeb.com/developers/#nuxt",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Avdebcom/nuxt-avdeb.git"
	},
	"bugs": {
		"url": "https://github.com/Avdebcom/nuxt-avdeb/issues"
	},
	"author": {
		"name": "AVDEB",
		"url": "https://avdeb.com/developers/"
	},
	"keywords": [
		"nuxt",
		"nuxt-module",
		"vue",
		"affiliate",
		"affiliate-links",
		"products",
		"product-embed",
		"carousel",
		"avdeb"
	],
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepack": "nuxt-module-build build",
		"dev": "nuxi dev playground",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"test": "vitest run",
		"test:types": "vue-tsc --noEmit"
	},
	"dependencies": {
		"@nuxt/kit": "^4.0.0"
	},
	"devDependencies": {
		"@nuxt/content": "^3.17.0",
		"@nuxt/module-builder": "^1.0.4",
		"@nuxt/schema": "^4.6.4",
		"@nuxt/test-utils": "^4.4.0",
		"@types/node": "^24.0.0",
		"nuxt": "^4.6.4",
		"typescript": "^5.9.3",
		"vitest": "^4.0.0",
		"vue-tsc": "^3.0.0"
	}
}
